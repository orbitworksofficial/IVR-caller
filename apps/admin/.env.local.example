# Supabase project — same project the FastAPI backend uses.
# Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here

# The FastAPI backend origin.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Where widget.js is served from — used to generate the embed snippet.
NEXT_PUBLIC_WIDGET_URL=http://localhost:8000/widget.js
