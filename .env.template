# ==============================================================================
# OrbitWorks Chatbot — Environment Variables
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# ==============================================================================

# ── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard -> Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_ANON_PUBLIC_KEY
# Service role key — bypasses RLS. Server-side only.
# Never expose to a browser and never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# ── LLM provider ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=YOUR_OPENAI_KEY
# Leave unset for OpenAI. For free Groq dev, uncomment:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ── Embeddings ───────────────────────────────────────────────────────────────
# Unset = OpenAI text-embedding-3-small (1536-dim) — matches the DB schema.
# Set to "local" only if you also resized the vector column to 384.
# EMBEDDING_PROVIDER=local

# ── Application ──────────────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Rate limiting (optional; defaults shown) ─────────────────────────────────
# RATE_LIMIT_MAX_REQUESTS=20
# RATE_LIMIT_WINDOW_SECONDS=60

# ── Test targets (set after seeding) ─────────────────────────────────────────
TEST_TENANT_ID=
TEST_BOT_ID=
