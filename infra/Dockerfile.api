# FastAPI backend + the built widget bundle it serves at /widget.js
#
# Two stages: the first builds the Preact widget with Node, the second runs the
# Python API and copies that bundle in. Node never ships in the final image.

# ── Stage 1: build the widget ────────────────────────────────────────────────
FROM node:22-alpine AS widget-builder

WORKDIR /build

# Copy manifests first so npm ci is cached unless dependencies actually change.
COPY apps/widget/package.json apps/widget/package-lock.json ./
RUN npm ci

COPY apps/widget/ ./
RUN npm run build
# Produces /build/dist/widget.js

# ── Stage 2: the API ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS api

# Fail fast, no .pyc files, unbuffered logs so docker logs shows output live.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# curl is used by the container healthcheck below.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies before copying source, so a code change does not
# invalidate the (slow) dependency layer.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir "uvicorn[standard]" gunicorn

# Application code
COPY ai/ ./ai/
COPY apps/api/ ./apps/api/
COPY apps/__init__.py ./apps/
COPY workers/ ./workers/
COPY scripts/ ./scripts/

# The widget bundle, at the path apps/api/main.py expects (apps/widget/dist).
COPY --from=widget-builder /build/dist/ ./apps/widget/dist/

# Run as a non-root user — a compromised process should not own the filesystem.
RUN useradd --create-home --shell /bin/bash appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

# Uvicorn workers under gunicorn: gunicorn handles process supervision and
# restarts, uvicorn handles async. WEB_CONCURRENCY tunes worker count.
CMD ["gunicorn", "apps.api.main:app", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "2", \
     "--timeout", "120", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
