# Keeps secrets and bulk out of the Docker build context.
#
# The .env exclusions matter most: without them, `COPY . .` in a Dockerfile
# would bake the service-role key into an image layer, where it survives even
# if the file is deleted in a later layer.

# Secrets — never in an image
.env
.env.*
!.env.example
!.env.template
**/.env
**/.env.local
**/.env.*.local

# Dependencies (reinstalled inside the image)
node_modules
**/node_modules
.venv
venv
__pycache__
**/__pycache__
*.pyc

# Build output (regenerated inside the image)
.next
**/.next
dist
**/dist
*.tsbuildinfo

# Version control and CI
.git
.gitignore
.github

# Local tooling state
supabase/.temp
supabase/.branches
.vscode
.idea
.claude

# Client knowledge documents — confidential, and ingested via the API not the image
knowledge/
*.pdf

# Tests and docs (not needed at runtime)
test_*.py
demo_*.py
docs/
*.md
!README.md

# OS noise
.DS_Store
Thumbs.db
