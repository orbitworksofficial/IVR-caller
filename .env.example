# ==============================================================================
# OrbitWorks Chatbot — Environment Configuration Example (.env)
# Copy this file to .env and fill in the secrets.
# ==============================================================================

# ── LLM & AI PROVIDER CONFIG ─────────────────────────────────────────────────
# For Production: Use OpenAI API Key (leave BASE_URL unset to default to OpenAI)
# For Development: Use Groq API key and base URL for free development
OPENAI_API_KEY=gsk_your_groq_or_openai_key_here
# Uncomment for local Groq development:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ── EMBEDDING CONFIG ──────────────────────────────────────────────────────────
# For Production: Comment out EMBEDDING_PROVIDER to default to OpenAI text-embedding-3-small (1536-dim)
# For Development: Set to "local" to use free local sentence-transformers (384-dim, no key needed)
EMBEDDING_PROVIDER=local

# ── DATABASE & SUPABASE CONFIG ────────────────────────────────────────────────
# Get these from: Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Anonymous/Public key (used by frontend client connections)
SUPABASE_KEY=sb_publishable_your_anon_key_here
# Service role secret key (used for migrations/seeding/admin scripts only — bypasses RLS)
# Keep this secure. Do not expose this key to client-side code or browser widgets.
SUPABASE_SERVICE_KEY=sb_secret_your_service_role_key_here

# ── APPLICATION SETTINGS ──────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── TEST SUITE VARIABLES ──────────────────────────────────────────────────────
# Set after running seed_knowledge.py to target integration tests
TEST_TENANT_ID=your_test_tenant_uuid_here
TEST_BOT_ID=your_test_bot_uuid_here
