# ==============================================================================
# OrbitWorks Chatbot — Environment Configuration Example (.env)
# Copy this file to .env and fill in the secrets.
# ==============================================================================

# ── LLM & AI PROVIDER CONFIG ─────────────────────────────────────────────────
# For Production: Use OpenAI API Key (leave BASE_URL unset to default to OpenAI)
# For Development: Use Groq API key and base URL for free development
OPENAI_API_KEY=gsk_your_groq_or_openai_key_here
# Uncomment for local Groq development:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ── EMBEDDING CONFIG ──────────────────────────────────────────────────────────
# For Production: Comment out EMBEDDING_PROVIDER to default to OpenAI text-embedding-3-small (1536-dim)
# For Development: Set to "local" to use free local sentence-transformers (384-dim, no key needed)
EMBEDDING_PROVIDER=local

# ── DATABASE & SUPABASE CONFIG ────────────────────────────────────────────────
# Get these from: Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Anonymous/Public key (used by frontend client connections)
SUPABASE_KEY=sb_publishable_your_anon_key_here
# Service role secret key (used for migrations/seeding/admin scripts only — bypasses RLS)
# Keep this secure. Do not expose this key to client-side code or browser widgets.
SUPABASE_SERVICE_KEY=sb_secret_your_service_role_key_here

# ── APPLICATION SETTINGS ──────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── TEST SUITE VARIABLES ──────────────────────────────────────────────────────
# Set after running seed_knowledge.py to target integration tests
TEST_TENANT_ID=your_test_tenant_uuid_here
TEST_BOT_ID=your_test_bot_uuid_here

# ── VOICE / AI IVR LAYER (Hammad — Phase 1 & 2) ──────────────────────────────

# Deepgram — Streaming Speech-to-Text (STT)
# Get your key at: https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-2-phonecall        # Optimized for 8kHz phone audio. Alternative: nova-2

# ElevenLabs — Streaming Text-to-Speech (TTS)
# Get your key at: https://elevenlabs.io/settings
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_DEFAULT_VOICE_ID=your_voice_id_here    # Orbit Works default voice (from ElevenLabs voice library)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5             # Lowest latency. Alternative: eleven_turbo_v2_5

# Twilio — Telephony (set by Kashif; listed here so env is complete)
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX                  # E.164 Orbit Works Twilio number

# ── VOICE GATEWAY (Kashif) ────────────────────────────────────────────────────
# Public https origin Twilio reaches the gateway on. Used to build the wss://
# stream URL and to verify X-Twilio-Signature (must match the console URL exactly).
# Local dev: your ngrok URL, e.g. https://abc123.ngrok-free.app
VOICE_PUBLIC_BASE_URL=https://chat.orb-itworks.com
VOICE_VALIDATE_TWILIO_SIGNATURE=true   # only set false for local curl testing
VOICE_RECORDING_ENABLED=true           # per-bot override: ivr_bot_configs.call_recording_enabled
VOICE_PORT=18001
# Shared secret for POST /voice/outbound/dial (server-to-server). Unset = outbound disabled.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
VOICE_DIAL_API_KEY=
# Campaign runner: dials active call_campaigns' contacts (always through the dial policy).
# Off by default; turn on only once consent records exist and the gateway is tested.
VOICE_CAMPAIGN_RUNNER=false
VOICE_CAMPAIGN_POLL_S=30

# ── VOICE BEHAVIOR SETTINGS ───────────────────────────────────────────────────
# Latency tuning (milliseconds)
VOICE_ENDPOINTING_MS=300          # Silence after which STT fires final transcript
VOICE_UTTERANCE_END_MS=1000       # Max utterance length before forced endpoint
VOICE_DEAD_AIR_TIMEOUT_MS=2000    # Max agent processing time before filler phrase fires
